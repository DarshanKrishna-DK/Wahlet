{
    "name": "wahlet",
    "version": "0.1.0",
    "private": true,
    "description": "A local-first MCP payment wallet for Whitechain",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "wahlet": "dist/mcp/index.js"
    },
    "scripts": {
        "build": "tsc && vite build",
        "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
        "dev": "node --import tsx src/local/server.ts",
        "web": "vite --host 127.0.0.1",
        "start": "node dist/local/server.js",
        "mcp": "node dist/mcp/index.js",
        "merchant": "node --import tsx examples/paid-api/server.ts",
        "check:invariants": "node --import tsx checks/payment-invariants.ts && node --import tsx checks/recovery-regressions.ts",
        "console": "node scripts/open-console.mjs"
    },
    "dependencies": {
        "@fontsource/geist": "5.3.0",
        "@fontsource/geist-mono": "5.3.0",
        "@fontsource/space-grotesk": "5.3.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@x402/core": "2.30.0",
        "@x402/evm": "2.30.0",
        "dotenv": "18.0.9",
        "lucide-react": "1.70.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "three": "0.187.0",
        "undici": "8.12.4",
        "viem": "2.57.16",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.187.0",
        "@vitejs/plugin-react": "6.2.1",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.6"
    }
}
